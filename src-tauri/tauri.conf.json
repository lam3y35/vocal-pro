{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VocalPro",
  "version": "3.0.0",
  "identifier": "com.lam3y.vocalpro",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VocalPro v3 — Studio AI Vocal & Stem Separator",
        "width": 1320,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob: asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "appimage"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "fileAssociations": [
      {
        "ext": ["mp3", "wav", "flac", "ogg", "mp4", "mkv", "avi", "mov"],
        "name": "VocalPro Media File",
        "description": "Open in VocalPro AI Stem Separator",
        "role": "Viewer"
      }
    ]
  }
}
